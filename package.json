  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@react-email/ui": "^6.11.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
